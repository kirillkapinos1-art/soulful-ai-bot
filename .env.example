# Токен Telegram-бота от @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Ключ Google Gemini API (https://aistudio.google.com/apikey)
AI_API_KEY=your_gemini_api_key_here

# Модель Gemini (по умолчанию gemini-flash-lite-latest)
AI_MODEL=gemini-flash-lite-latest

# Необязательно: параметры webhook-режима (например, для Railway)
# WEBHOOK_URL=https://your-app.up.railway.app
# WEBHOOK_SECRET=your_random_webhook_secret
# RAILWAY_VOLUME_MOUNT_PATH=/data
